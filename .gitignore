# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.cache/
**/.build/
**/.swiftpm/

# next.js
/.next/
/out/

# production
/build
/packages/vector-cli/dist
/packages/vector-cli/native
/packages/vector-cli/*.tgz

# android
/apps/android/.gradle/
/apps/android/local.properties
/apps/android/**/build/
/apps/android/.idea/
*.jks
*.keystore
*service-account*.json
*play-publisher*.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vector-cli local dev data (keep the directory, ignore contents)
.vector-dev/*
!.vector-dev/.gitkeep
.vector-dev-collaboration/
