{
  "name": "vector",
  "version": "0.1.0",
  "packageManager": "pnpm@11.17.0",
  "description": "Open source project management platform built with Next.js and Convex.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xrehpicx/vector.git"
  },
  "bugs": {
    "url": "https://github.com/xrehpicx/vector/issues"
  },
  "homepage": "https://github.com/xrehpicx/vector#readme",
  "keywords": [
    "project-management",
    "issue-tracking",
    "nextjs",
    "convex",
    "typescript"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:collaboration": "node scripts/dev-collaboration.mjs",
    "build": "next build",
    "start": "next start",
    "cli": "tsx packages/vector-cli/src/index.ts",
    "vcli:dev": "VECTOR_HOME=$(pwd)/.vector-dev tsx packages/vector-cli/src/index.ts --profile devlocal --app-url http://localhost:3000",
    "cli:dev-bridge": "VECTOR_HOME=$(pwd)/.vector-dev tsx packages/vector-cli/src/index.ts --profile devlocal --app-url http://localhost:3000 service run",
    "cli:dev-collaboration": "VECTOR_HOME=$(pwd)/.vector-dev-collaboration tsx packages/vector-cli/src/index.ts --profile collaboration-dev --app-url http://localhost:4200",
    "cli:dev-collaboration-bridge": "VECTOR_HOME=$(pwd)/.vector-dev-collaboration VECTOR_DISABLE_MENU_BAR=1 tsx packages/vector-cli/src/index.ts --profile collaboration-dev --app-url http://localhost:4200 service run",
    "build:cli-package": "pnpm --filter @rehpic/vcli build",
    "test:cli": "vitest run packages/vector-cli/src/auth.test.ts packages/vector-cli/src/index.test.ts packages/vector-cli/src/session.test.ts packages/vector-cli/src/runtime-config.test.ts packages/vector-cli/src/version.test.ts packages/vector-cli/src/work-watch.test.ts packages/vector-cli/src/bridge-service.test.ts packages/vector-cli/src/agent-adapters.test.ts packages/vector-cli/src/acp-runtime.test.ts",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:convex",
    "typecheck:app": "tsgo -p tsconfig.json --noEmit --pretty false",
    "typecheck:convex": "tsgo -p convex/tsconfig.json --noEmit --pretty false",
    "lint": "pnpm lint:fast && pnpm lint:eslint",
    "lint:fast": "oxlint .",
    "lint:eslint": "eslint . --cache --cache-strategy content --cache-location .cache/eslint/.eslintcache --concurrency auto",
    "lint:app": "oxlint . --ignore-pattern 'convex/**' && eslint . --ignore-pattern 'convex/**' --cache --cache-strategy content --cache-location .cache/eslint/.eslintcache --concurrency auto",
    "lint:convex": "oxlint convex && eslint convex --cache --cache-strategy content --cache-location .cache/eslint/.eslintcache --concurrency auto",
    "lint:react": "react-doctor . --verbose --scope changed --base origin/main",
    "auth:generate": "cd convex/betterAuth && pnpm dlx auth generate -y",
    "lint:fix": "oxlint . --fix && eslint . --fix --cache --cache-strategy content --cache-location .cache/eslint/.eslintcache --concurrency auto",
    "lint:app:fix": "oxlint . --fix --ignore-pattern 'convex/**' && eslint . --fix --ignore-pattern 'convex/**' --cache --cache-strategy content --cache-location .cache/eslint/.eslintcache --concurrency auto",
    "lint:convex:fix": "oxlint convex --fix && eslint convex --fix --cache --cache-strategy content --cache-location .cache/eslint/.eslintcache --concurrency auto",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "project:setup": "tsx scripts/project-setup.ts",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "generate:keys": "node generateKeys.mjs"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.25",
    "@ai-sdk/provider-utils": "^4.0.40",
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@anthropic-ai/sdk": "^0.115.0",
    "@base-ui/react": "^1.6.0",
    "@clack/prompts": "^1.7.0",
    "@convex-dev/agent": "0.6.4",
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/migrations": "^0.3.6",
    "@convex-dev/presence": "0.4.0",
    "@cursor/sdk": "^1.0.26",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@github/copilot-sdk": "1.0.8",
    "@hookform/resolvers": "^5.5.7",
    "@legendapp/list": "^3.3.3",
    "@openai/codex-sdk": "^0.145.0",
    "@opencode-ai/sdk": "^1.18.9",
    "@openrouter/ai-sdk-provider": "2.10.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-mention": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-table-cell": "^3.29.2",
    "@tiptap/extension-table-header": "^3.29.2",
    "@tiptap/extension-table-row": "^3.29.2",
    "@tiptap/extension-task-item": "^3.29.2",
    "@tiptap/extension-task-list": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/markdown": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/suggestion": "^3.29.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "6.0.237",
    "avvvatars-react": "^0.4.2",
    "better-auth": "1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "commander": "^15.0.0",
    "convex": "^1.42.3",
    "convex-helpers": "^0.1.120",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "input-otp": "^1.4.2",
    "jose": "^6.2.4",
    "lucide-react": "^1.27.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^9.0.3",
    "ogl": "^1.0.11",
    "open": "^11.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "streamdown": "2.5.0",
    "tailwind-merge": "^3.6.0",
    "tippy.js": "^6.3.7",
    "vitest": "^4.1.10",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-doctor": "0.9.2",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "7.3.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,scss,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
